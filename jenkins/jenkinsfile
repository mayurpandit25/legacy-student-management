pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }

    environment{
        MY_AWS_CRED = credentials('aws-cred')
    }

    stages {
        stage("checkout"){
            steps{
                git 'https://github.com/mayurpandit25/studentapp-ui.git'
                echo "Clonning is successful"
            }
        }

        stage("Build"){
            steps{
                sh 'mvn clean package'
            }
            post{
                success{
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to s3'){
            steps{
                sh '''
                  aws s3 cp target/*.war s3://mayurcbz.spacee/Arfifacts/student.war
                '''
            }
        }

        stage('SonarQube Analysis'){
            steps{
                withSonarQubeEnv('sonar'){
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gates'){
            steps{
                timeout(time:5 , unit:'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build'){
            steps{
                sh '''
                  docker build -t student .
                  docker images
                '''
            }
        }

        stage('Push image to ECR'){
            steps {
                sh '''
                    aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 419819289041.dkr.ecr.us-east-2.amazonaws.com
                    docker tag student:latest 419819289041.dkr.ecr.us-east-2.amazonaws.com/student:latest
                    docker push 419819289041.dkr.ecr.us-east-2.amazonaws.com/student:latest
                '''
            }
        }

        stage('Deployment on k8s'){
            steps{
                sh '''
                    aws eks update-kubeconfig --name my-cluster-mayur --region us-east-2
                    kubectl apply -f k8s/
                    kubectl get pods
                    sleep 20
                    kubectl get pods
                    kubectl get svc -o wide
                '''
            }
        }
    }
}